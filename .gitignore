# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/.test-dist

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — cualquier .env con valores reales.
# OJO: `.env*.local` NO cubre archivos de trabajo como `.env.nocl`, que sí
# traen secretos reales bajados de Vercel. Se ignora todo salvo el ejemplo.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups y scratch (no deben entrar al repo)
*.bak
*.bak2
*.bak.community
.baul-build.log
_audit_console.js
_deploy/
.taller-shots/
bsd_*.py
bsd-*.md
__pycache__/
*.pyc

# QA de B4: catálogo real medido y capturas de la pantalla.
# NO entran al repo: turbillon50/vforge es PÚBLICO y ese JSON trae nombres de
# clientes, montos y comentarios. Se regeneran con:
#   npx tsc -p tsconfig.test.json
#   DATABASE_URL=... node --require ./.test-dist/tests/alias-hook.js .test-dist/scripts/qa/medir-b4.js
/qa/
