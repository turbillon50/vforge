[Unit]
Description=Vulcano — daemon de conciencia continua (capa 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/agents/cognition
ExecStart=/usr/bin/python3 /root/agents/cognition/daemon.py loop
# Variables: heredadas del entorno o /root/agents/cognition/.env
EnvironmentFile=-/root/agents/cognition/.env
Restart=always
RestartSec=15
StandardOutput=append:/var/log/vulcano-daemon.log
StandardError=append:/var/log/vulcano-daemon.log

[Install]
WantedBy=multi-user.target
