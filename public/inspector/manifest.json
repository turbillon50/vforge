{
  "manifest_version": 3,
  "name": "VForge Inspector",
  "version": "2.0.0",
  "description": "Fotografía la pestaña y la manda a la sala. Claude, Cursor y Grok la ven por MCP.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "VForge Inspector",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "exclude_matches": ["https://chrome.google.com/*"]
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Activar inspector"
    }
  }
}
